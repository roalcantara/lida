{
  "lineWidth": 120,
  "indentWidth": 2,
  "markdown": { "lineWidth": 120 },
  "json": { "preferSingleLine": true },
  "exec": { "commands": [{ "command": "shfmt -i {{indent_width}} --apply-ignore", "exts": ["sh", "bash"] }] },
  "excludes": [
    "target/**",
    "tmp/**",
    "crates/*/tests/snapshots/**",
    "crates/*/tests/fixtures/**",
    "TODO.md",
    "CHANGELOG.md",
    ".mise/**",
    ".claude/settings.local.json",
    "**/*.lock"
  ],
  "plugins": [
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d"
  ]
}
